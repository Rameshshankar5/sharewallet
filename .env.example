# Copy this file to `.env` and paste the values from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# These are NOT secrets. Every Firebase client app ships them. Access is
# controlled by firestore.rules, not by hiding these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — image hosting for profile pictures and receipt photos.
# Firebase Storage needs a billing-enabled project, so images go here instead.
#
# Cloud name: Cloudinary dashboard, top left.
# Presets:    Settings -> Upload -> Upload presets. BOTH must be Unsigned.
#             Never put the API key or secret here — the app does not use them
#             and anything in .env ships inside the APK.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_AVATAR_PRESET=sharewallet_avatars
EXPO_PUBLIC_CLOUDINARY_RECEIPT_PRESET=sharewallet_receipts
