# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Local Firebase credentials
.env
.env.local

# Compiled output for the maths tests
.math-build/

# Local Firebase CLI project alias
.firebaserc

# Release signing key — NEVER commit
credentials/
*.keystore

# Push notification credentials.
# google-services.json is client config (it ships inside the APK), but it names
# your Firebase project, and this repo is public — same reasoning as .env.
google-services.json
# The FCM service account key is a REAL secret. It goes to Expo, never here.
*-firebase-adminsdk-*.json
service-account*.json

# Firebase CLI deploy cache
.firebase/
*-debug.log
